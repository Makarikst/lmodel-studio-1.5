<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <EditText android:id="@+id/etName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_rag_name" android:textColor="@color/text_primary"/>
        <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_rag_desc" android:textColor="@color/text_primary"/>
        <EditText android:id="@+id/etKnowledge" android:layout_width="match_parent" android:layout_height="200dp"
            android:gravity="top" android:hint="@string/hint_rag_knowledge" android:inputType="textMultiLine"
            android:textColor="@color/text_primary" android:background="@drawable/bg_card" android:padding="10dp"/>
        <Button android:id="@+id/btnSaveRag" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/btn_save_rag" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
