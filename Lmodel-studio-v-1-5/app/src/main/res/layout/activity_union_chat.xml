<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/background">
    <TextView android:id="@+id/tvUnionSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:textColor="@color/text_secondary" android:textSize="13sp"
        android:background="@drawable/bg_card"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvUnionMessages"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:padding="8dp"/>
    <Button android:id="@+id/btnStartStop" android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_margin="12dp" android:text="@string/btn_union_start" android:textAllCaps="false"
        android:textColor="@color/text_on_dark"/>
</LinearLayout>
