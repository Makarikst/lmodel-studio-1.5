<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/union_beta_badge" android:textColor="@color/purple_500" android:textStyle="bold"/>
        <EditText android:id="@+id/etUnionName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_union_name" android:textColor="@color/text_primary" android:layout_marginTop="12dp"/>
        <EditText android:id="@+id/etTopic" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="@string/hint_union_topic" android:textColor="@color/text_primary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/label_model_a" android:textColor="@color/text_secondary"/>
        <Spinner android:id="@+id/spinnerModelA" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/label_model_b" android:textColor="@color/text_secondary"/>
        <Spinner android:id="@+id/spinnerModelB" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/btnCreateUnion" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/btn_create_union" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
