<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp">
    <TextView android:id="@+id/tvSpeaker" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/purple_500" android:textStyle="bold" android:textSize="12sp"/>
    <TextView android:id="@+id/tvText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:background="@drawable/bg_bubble_bot" android:padding="12dp"
        android:textColor="@color/text_primary"/>
</LinearLayout>
