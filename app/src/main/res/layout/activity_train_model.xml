<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_add_text_training"
        android:textColor="@color/text_secondary"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etTrainingText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="top"
        android:hint="@string/hint_training_text"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/btn_add_text"
        android:textAllCaps="false"
        app:backgroundTint="@color/purple_500"
        app:cornerRadius="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Датасет / файлы (как текст)"
        android:textColor="@color/text_secondary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="json, csv, parquet, arrow, text, zip (imagefolder/soundfolder/webdataset). Всё идёт в обучение как текст."
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImportDataset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Загрузить датасет"
        android:textAllCaps="false"
        app:backgroundTint="@color/purple_700"
        app:cornerRadius="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddFile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Файл"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddPhoto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Фото"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAudio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Аудио"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Видео"
            android:textAllCaps="false"
            android:textSize="12sp"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPendingFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etMediaDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:gravity="top"
        android:hint="Описание файла (для фото/аудио/видео)"
        android:inputType="textMultiLine"
        android:minLines="2"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveMedia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Сохранить файл в обучение"
        android:textAllCaps="false"
        app:backgroundTint="@color/purple_500"
        app:cornerRadius="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_training_data"
        android:textColor="@color/text_secondary"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTrainingItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartTraining"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_start_training"
        android:textAllCaps="false"
        android:textStyle="bold"
        app:backgroundTint="@color/purple_500"
        app:cornerRadius="14dp" />
</LinearLayout>
