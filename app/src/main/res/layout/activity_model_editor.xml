<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etModelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:hint="@string/hint_model_name"
            android:inputType="text"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_model_supports"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbSupportsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:enabled="false"
            android:text="@string/type_text"
            android:textColor="@color/text_primary" />

        <CheckBox
            android:id="@+id/cbSupportsPhoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_photo"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cbSupportsVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_video"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cbSupportsAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/type_audio"
            android:textColor="@color/text_primary"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_system_prompt"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSystemPromptReadonly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="top"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:textColorHint="@color/text_hint" />

        <TextView
            android:id="@+id/tvTrainedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_save"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_500"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrainModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_train_model"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrainMarkdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_train_markdown"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrainCoding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_train_coding"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrainBash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_train_bash"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrainProlog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_train_prolog"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDevMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_dev_mode"
            android:textAllCaps="false"
            app:backgroundTint="@color/purple_500"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_parameters"
            android:textColor="@color/text_secondary"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvParameters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddParameter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/btn_add_parameter"
            android:textAllCaps="false"
            android:visibility="gone"
            app:backgroundTint="@color/purple_700"
            app:cornerRadius="12dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
